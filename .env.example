# Kopieer naar .env en pas aan. Zet hier NOOIT echte sleutels in versiebeheer (.env staat in .gitignore).

# ---------------------------------------------------------------- AI-provider
# mock      = demodata, volledig offline (standaard)
# anthropic = echte AI: Claude voor analyse + lokale Whisper voor transcriptie
#             (eenmalig installeren: npm run setup:ai)
AI_PROVIDER=mock

# Alleen bij AI_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high          # low | medium | high | xhigh | max

# Transcriptie bij een echte provider:
# whisper = lokaal met faster-whisper (audio verlaat de computer niet)
# mock    = vaste demotekst; handig om alleen de analyse door Claude te testen
TRANSCRIBER=whisper
WHISPER_MODEL=small              # tiny | base | small | medium | large-v3
# WHISPER_DEVICE=auto            # auto | cpu | cuda
# WHISPER_COMPUTE_TYPE=int8

# Kunstmatige vertraging per mock-stap in seconden (laat laadtoestanden zien)
MOCK_DELAY_SECONDS=1.5

# Database (standaard SQLite in backend/data/). Later bijv. postgresql+psycopg://user:pass@host/db
# DATABASE_URL=sqlite:///backend/data/meetings.db

# Toegestane frontend-origins (komma-gescheiden)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

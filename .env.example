# Kopieer naar .env en pas aan. Zet hier NOOIT echte sleutels in versiebeheer.

# Actieve AI-provider: mock | openai | anthropic   (alleen 'mock' is geïmplementeerd)
AI_PROVIDER=mock

# Kunstmatige vertraging per mock-stap in seconden (laat laadtoestanden zien)
MOCK_DELAY_SECONDS=1.5

# Database (standaard SQLite in backend/data/). Later bijv. postgresql+psycopg://user:pass@host/db
# DATABASE_URL=sqlite:///backend/data/meetings.db

# Toegestane frontend-origins (komma-gescheiden)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pas nodig zodra een echte provider is aangesloten
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
